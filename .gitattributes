# Normalise line endings so the project behaves the same on Windows (where it is
# developed) and on Linux (where Netlify builds it). Text files are stored with
# LF in Git; Windows PowerShell scripts keep CRLF.
* text=auto eol=lf
*.ps1 text eol=crlf

# Binary files: never touch or diff them as text.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.xlsx binary
