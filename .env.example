# ---------------------------------------------------------------------------
# COPY THIS FILE TO .env AND FILL IN YOUR OWN VALUES:
#   Windows PowerShell:  Copy-Item .env.example .env
#
# The same variables go into Netlify (Site configuration -> Environment
# variables) for the live site https://setgpa.com - see docs/DEPLOY-NETLIFY.md.
# .env itself is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# 1) DATABASE_URL  (SERVER ONLY - never exposed to the browser)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Local PostgreSQL example (default superuser is "postgres"):
#
# Keep &connection_limit=5 on the end. `next build` pre-renders pages in
# parallel worker processes, each opening its own pool; without the cap they
# exceed PostgreSQL's max_connections and the build fails with
# "too many clients already".
#
# On Netlify you do NOT set this: Netlify Database supplies NETLIFY_DB_URL and
# the site uses it automatically. Set DATABASE_URL on Netlify only if you want
# to use a different hosted database instead.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/gpa_calculator?schema=public&connection_limit=5"

# 2) DIRECT_URL  (SERVER ONLY - used by Prisma migrations, never by the site)
# Locally: the same value as DATABASE_URL.
# On Netlify: not needed with Netlify Database (the build reuses its connection).
# With another hosted database: its DIRECT (non-pooled) connection string.
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/gpa_calculator?schema=public&connection_limit=5"

# 3) NEXT_PUBLIC_WHATSAPP_NUMBER  (PUBLIC - shipped to the browser)
# International format, digits only: country code + number, NO "+", NO spaces, NO dashes.
# Pakistan example: 0300 1234567  ->  923001234567
NEXT_PUBLIC_WHATSAPP_NUMBER="YOUR_WHATSAPP_NUMBER"

# 4) NEXT_PUBLIC_CONTACT_EMAIL  (PUBLIC - shipped to the browser)
# Shown on the contact page and in the footer. Leave empty to hide it.
NEXT_PUBLIC_CONTACT_EMAIL="you@example.com"

# 5) NEXT_PUBLIC_SITE_URL  (PUBLIC - used for canonical URLs, sitemap.xml and Open Graph)
# Local development:
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Production is https://setgpa.com. netlify.toml already sets it, and a
# production build defaults to it even if the variable is missing.
