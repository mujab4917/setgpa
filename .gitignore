# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# testing
/coverage

# environment variables (NEVER commit real secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# .env.example IS committed on purpose - it contains no real values.
!.env.example

# prisma
/prisma/*.db
/prisma/*.db-journal

# netlify (created by the Netlify CLI; local link info only)
.netlify

# Claude Code / editor-assistant local settings (machine specific)
/.claude

# generated data exports (recreate any time with: npm run db:export)
/exports

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel
*.tsbuildinfo
